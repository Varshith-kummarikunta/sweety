# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_db
TEST_DB_NAME=sweety_test_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Alternatively, connection URI:
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/sweety_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
